# LLM provider: "openai" (local) or "azure" (production)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Models (never hard-code these in the code)
MODEL_SMALL=gpt-4o-mini
MODEL_LARGE=gpt-4o

# Mock ADP API
ADP_BASE_URL=http://127.0.0.1:8000
MOCK_ADP_API_KEY=

# Ingestion (the product's side: never mentions "mock")
ADP_API_KEY=
PAYROLL_DB_PATH=data/sources/sql/payroll.db

# Azure OpenAI (only when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=


# LangSmith tracing (optional, off by default). When on, every workflow step and
# LLM call is sent to LangSmith's servers: use it with synthetic data only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tax-doc-analysis-agent
